{
  "name": "crypto-market-anomaly-detector",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "kill-port": "npx kill-port 5000",
    "preserver": "npm run kill-port",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "postinstall": "cd server && npm install",
    "dev:all": "concurrently --kill-others \"npm run dev\" \"npm run server\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src server --ext .js,.vue",
    "lint:fix": "eslint src server --ext .js,.vue --fix",
    "format": "prettier --write \"src/**/*.{js,vue,css}\" \"server/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css}\" \"server/**/*.js\""
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@vueuse/core": "^14.1.0",
    "axios": "^1.13.2",
    "lightweight-charts": "^4.1.0",
    "pinia": "^3.0.4",
    "socket.io-client": "^4.8.1",
    "vue": "^3.4.35",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@vitejs/plugin-vue": "^6.0.6",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.1",
    "postcss": "^8.5.6",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.1.17",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}
