{
  "name": "crypto-market-anomaly-detector",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "kill-port": "npx kill-port 5000",
    "preserver": "npm run kill-port",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "postinstall": "cd server && npm install",
    "dev:all": "concurrently --kill-others \"npm run dev\" \"npm run server\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@vueuse/core": "^14.1.0",
    "axios": "^1.13.2",
    "lightweight-charts": "^4.1.0",
    "pinia": "^3.0.4",
    "socket.io-client": "^4.8.1",
    "vue": "^3.4.35",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@vitejs/plugin-vue": "^5.1.2",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}
