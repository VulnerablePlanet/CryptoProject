# Server Environment Variables

# Server Port
PORT=5000

# MongoDB Connection
MONGODB_URI_LOCAL=mongodb://localhost:27017/crypto-analyzer
MONGODB_URI_PROD=your_mongodb_connection_string_here

# Environment (development or production)
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Origin (frontend URL)
CORS_ORIGIN=http://localhost:5173

# CoinGecko API Key (get free key at https://www.coingecko.com/en/api)
COINGECKO_API_KEY=your_coingecko_api_key_here

# =============================================================================
# TRADING BOT - API KEYS FOR REAL TRADING
# =============================================================================
# IMPORTANT: Start with SANDBOX mode to test before using real money!
#
# Binance API Setup:
# 1. Go to https://www.binance.com -> Profile -> API Management
# 2. Create API Key with "Enable Spot & Margin Trading"
# 3. NEVER give withdrawal permissions to the API key
# 4. Add your keys below
#
# BINANCE_MODE options:
# sandbox = Use testnet (no real money, simulate trading)
# production = Use real Binance account (REAL MONEY AT RISK)

# Binance API Keys
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Trading Mode: 'sandbox' for testnet, 'production' for real money
BINANCE_MODE=sandbox

# Optional: Keys for other exchanges supported by CCXT
# BITGET_API_KEY=your_bitget_api_key
# BITGET_API_SECRET=your_bitget_api_secret
# BYBIT_API_KEY=your_bybit_api_key
# BYBIT_API_SECRET=your_bybit_api_secret
